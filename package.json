{
  "name": "@wellactually/sdk",
  "version": "0.10.0",
  "type": "module",
  "description": "What a Well Actually principle's detector imports, and what its tests import to run under vitest.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/passsy/wellactually.git"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "exports": {
    "./v3": {
      "types": "./v3.d.ts",
      "default": "./v3.mjs"
    },
    "./v3/test": {
      "types": "./test.d.ts",
      "default": "./test.mjs"
    },
    "./v4": {
      "types": "./v4.d.ts",
      "default": "./v4.mjs"
    },
    "./v4/test": {
      "types": "./test.d.ts",
      "default": "./test.mjs"
    }
  },
  "files": [
    "*.mjs",
    "*.d.ts",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "esbuild": "^0.28.0"
  }
}
