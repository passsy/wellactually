{
  "name": "wellactually-client",
  "version": "0.12.0",
  "private": true,
  "type": "module",
  "description": "The Well Actually plugin, command and sandbox",
  "keywords": [
    "pi-package"
  ],
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "pi": {
    "extensions": [
      "./compat/pi.mjs"
    ],
    "skills": [
      "./node_modules/wellactually-runtime/opencode/skills"
    ]
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "prebuild": "node scripts/embed-sdk.mjs",
    "build": "node scripts/build.mjs",
    "prepackage": "node scripts/embed-sdk.mjs",
    "package": "node scripts/package.mjs",
    "test:package": "node scripts/test-package.mjs",
    "prepackage:local": "node scripts/embed-sdk.mjs",
    "package:local": "node scripts/install-local.mjs",
    "preinstall:local": "node scripts/embed-sdk.mjs",
    "install:local": "node scripts/install-local.mjs",
    "pretest": "node scripts/embed-sdk.mjs",
    "test": "vitest run",
    "pretypecheck": "node scripts/embed-sdk.mjs",
    "typecheck": "tsc --noEmit -p packages/tsconfig.json && tsc --noEmit -p evaluator/tsconfig.json && tsc --noEmit -p evaluator/principles/tsconfig.json",
    "preeval": "node scripts/embed-sdk.mjs",
    "eval": "node evaluator/run.ts",
    "prepackage:sdk": "node scripts/embed-sdk.mjs",
    "package:sdk": "node scripts/release-sdk.mjs",
    "test:package:sdk": "node scripts/test-sdk-package.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "~5.9.0",
    "vitest": "^4.0.0"
  },
  "dependencies": {
    "wellactually-runtime": "npm:wellactually@0.12.0"
  }
}
