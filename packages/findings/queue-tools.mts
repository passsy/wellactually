import { claimReviewSession, getReviewSession, claimReviewWork, completeReviewWork, beginVerification, retryVerification, blockReviewWork, reviewSessionSummary } from "./queues.mts";
import type { Tool } from "./tools.mts";
const string = { type: "string" };
const base = { repo: string, target: string, session: string };
const owner = { ...base, queue: string, worker: string };
const summary = (run: typeof claimReviewSession): Tool["run"] => (args, repo) => reviewSessionSummary(run(args, repo));
const tool = (name: string, description: string, properties: Record<string, unknown>, required: string[], run: Tool["run"]): Tool => ({ name, description, inputSchema: { type: "object", properties, required }, annotations: { readOnlyHint: name === "get_review_session", destructiveHint: false, openWorldHint: false }, run });
export const QUEUE_TOOLS: Tool[] = [
  tool("block_review_work", "Record an explicit safeguard/policy block on a dead worker's current item. It remains incomplete and cannot be reassigned automatically. Other eligible queue work may continue; never replay a blocked request through a replacement worker.", { ...owner, reason: string }, ["target", "session", "queue", "worker", "reason"], summary(blockReviewWork)),
  tool("retry_verification", "Coordinator only: reopen completed issue ids for another proof attempt after an infrastructure/context change. Preserve the frozen review, aggregation, previous attempts, finding IDs and human triage. Only selected proof items are retried; worker count becomes ceil(pending issues/10).", { ...base, items: { type: "array", items: string, minItems: 1 }, reason: string }, ["target", "session", "items", "reason"], summary(retryVerification)),
  tool("claim_review_session", "Start or resume an immutable review run. Create one principle queue per set; each gets ceil(principles/20) workers, minimum one. Include a source-only crossing set when required. Only pass retained principle IDs and pinned versions, never excluded principles or advice bodies.", { repo: string, target: string, run: string, scope: string, sets: { type: "array", items: { type: "object", properties: { id: string, principles: { type: "array", items: { type: "object", properties: { id: string, version: { type: "integer", minimum: 1 } }, required: ["id", "version"] } } }, required: ["id", "principles"] } } }, ["target", "run", "sets"], summary(claimReviewSession)),
  tool("get_review_session", "Read compact authoritative queue counts by default. Set includeResults:true and optionally queue to inspect completed investigations in MCP; do not copy them into local verdict files.", { ...base, includeResults: { type: "boolean" }, queue: string }, ["target", "session"], (raw, repo) => { const session = getReviewSession(raw, repo), args = raw as Record<string, unknown>; return args.includeResults === true ? { ...session, queues: session.queues.filter(q => !args.queue || q.id === args.queue) } : reviewSessionSummary(session); }),
  tool("claim_review_work", "Atomically claim the next source/principle/verification item. Returns an existing live claim for the same worker (also renews its 15-minute lease). Never claim another item before completing the current one. Waiting means other workers own the remaining work; complete means the queue is done.", owner, ["target", "session", "queue", "worker"], claimReviewWork),
  tool("complete_review_work", "Complete the claimed item. Review result: verdict, where (followed), findings:[candidate IDs], investigation:{status,reason,questions:[{question,answer,evidence}],limits}. Source uses findings and investigation without verdict. Inconsistent statuses are rejected immediately; correct within this conversation. Verification result: summary,proofs:[artifact paths],limits,decisions:[resolve_candidates decision for each member]. The server resolves findings and completes the queue item together; human disposition is untouched.", { ...owner, item: string, claim: string, result: { type: "object", additionalProperties: true } }, ["target", "session", "queue", "worker", "item", "claim", "result"], completeReviewWork),
  tool("begin_verification", "Aggregator only: after every review queue is complete, partition all run candidates into groups of the same issue. Include every candidate exactly once; singleton groups are fine. Do not verify or refute claims. Creates a shared proof queue with ceil(unique groups/10) verification workers.", { ...base, groups: { type: "array", items: { type: "object", properties: { candidates: { type: "array", items: string, minItems: 1 }, reason: string }, required: ["candidates", "reason"] } } }, ["target", "session", "groups"], summary(beginVerification)),
];
